            for (let i = items.length - 1; i >= 0; i--) {
                items[i].y += items[i].speed;
                
                // Xóa vật phẩm khi trượt khỏi đáy màn hình
                if (items[i].y > rect.height + 40) {
                    items.splice(i, 1);
                    continue;
                }

                // Thuật toán kiểm tra va chạm (Hứng đồ) - AABB cải tiến
                const item = items[i];
                if (item.x > player.x - 10 && item.x < player.x + player.width + 10 &&
                    item.y + item.size / 2 > player.y && item.y < player.y + player.height) {
                    
                    // Xử lý khi va chạm
                    handleCollision(item);
                    items.splice(i, 1);
                }
            }
        }

        // Xử lý va chạm vật phẩm
        function handleCollision(item) {
            if (item.info.isGreen) {
                // HỨNG TRÚNG ĐỒ XANH LÀ (🧉, 🍱, 🎒)
                comboStreak++;
                let pointsEarned = item.info.score;
                
                // Combo nhân hệ số điểm
                if (comboStreak >= 3) {
                    pointsEarned *= 2;
                    const comboIndicator = document.getElementById('combo-alert');
                    comboIndicator.classList.remove('hidden');
                    setTimeout(() => comboIndicator.classList.add('hidden'), 1000);
                }

                score += pointsEarned;
                sci = Math.min(100, sci + 2);
                playSound('catch');
                
                // Tạo hiệu ứng hạt lấp lánh màu xanh khi bắt được đồ tốt
                createParticles(item.x, item.y, '#10b981', 8);

                // Cứ hứng được 5 rác tốt là triệu hồi 1 Trạm Tri Thức (Quiz)
                if (comboStreak % 5 === 0) {
                    triggerQuiz();
                }
            } else {
                // HỨNG TRÚNG RÁC THẢI DÙNG MỘT LẦN (🥤, 📦, 🛍️)
                comboStreak = 0; // Reset Combo rèn luyện

                if (hasShield) {
                    // Phá vỡ Lá chắn thay vì trừ điểm/mạng
                    hasShield = false;
                    playSound('shield-break');
                    createParticles(player.x + player.width/2, player.y, '#38bdf8', 15);
                } else {
                    score = Math.max(0, score + item.info.score);
                    lives--;
                    sci = Math.max(0, sci - 5);
                    playSound('damage');
                    createParticles(item.x, item.y, '#f43f5e', 12);
                }

                if (lives <= 0) {
                    endGame(false);
                }
            }
            updateDashboard();
        }

        // Vẽ tất cả đồ họa lên Canvas
        function drawGame(rect) {
            ctx.clearRect(0, 0, rect.width, rect.height);

            // Vẽ vạch sọc nền trường học UEH (Grid mờ)
            ctx.strokeStyle = 'rgba(16, 185, 129, 0.04)';
            ctx.lineWidth = 1;
            for (let x = 0; x < rect.width; x += 40) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, rect.height);
                ctx.stroke();
            }

            // Vẽ các hạt lấp lánh (Particles)
            for (let i = 0; i < particles.length; i++) {
                const p = particles[i];
                ctx.save();
                ctx.globalAlpha = p.alpha;
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            // Vẽ các vật phẩm đang rơi bằng Emoji
            ctx.textBaseline = 'middle';
            ctx.textAlign = 'center';
            for (let i = 0; i < items.length; i++) {
                const item = items[i];
                ctx.font = `${item.size}px Inter`;
                ctx.fillText(item.info.emoji, item.x, item.y);
                
                // Hiển thị viền phát sáng nhẹ quanh đồ xanh tốt
                if (item.info.isGreen) {
                    ctx.save();
                    ctx.shadowBlur = 10;
                    ctx.shadowColor = '#10b981';
                    ctx.strokeStyle = 'rgba(16, 185, 129, 0.2)';
                    ctx.beginPath();
                    ctx.arc(item.x, item.y, item.size / 2, 0, Math.PI * 2);
                    ctx.stroke();
                    ctx.restore();
                }
            }

            // Vẽ người chơi: Chiếc GIỎ XANH TÁI CHẾ
            // Vẽ hào quang Lá chắn bảo vệ
            if (hasShield) {
                ctx.save();
                ctx.strokeStyle = '#38bdf8';
                ctx.lineWidth = 3;
                ctx.shadowBlur = 15;
                ctx.shadowColor = '#38bdf8';
                ctx.beginPath();
                ctx.ellipse(player.x + player.width / 2, player.y + player.height / 2, player.width / 1.5, player.height / 1.3, 0, 0, Math.PI * 2);
                ctx.stroke();
                ctx.restore();
            }

            // Vẽ chiếc giỏ bọc nhựa sinh học bảo vệ môi trường
            ctx.save();
            ctx.fillStyle = 'rgba(6, 78, 59, 0.45)'; // emerald-900 mờ
            ctx.strokeStyle = '#10b981'; // emerald-500
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            ctx.roundRect(player.x, player.y, player.width, player.height, [4, 4, 12, 12]);
            ctx.fill();
            ctx.stroke();
            ctx.restore();

            // Vẽ Emoji Đại diện Giỏ Rác Xanh ở chính giữa thanh trượt
            ctx.font = '16px Inter';
            ctx.fillText('🎒', player.x + player.width / 2, player.y + player.height / 2);
        }

        // Tạo hiệu ứng hạt vật lý lấp lánh (Sparkles physics)
        function createParticles(x, y, color, count) {
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = 1 + Math.random() * 2.5;
                particles.push({
                    x: x,
                    y: y,
                    radius: 2 + Math.random() * 2.5,
                    color: color,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed,
                    alpha: 1
                });
            }
        }

        // ================= KÍCH HOẠT TRẠM TRI THỨC (POPUP QUIZ) =================
        function triggerQuiz() {
            if (!gameActive) return;
            gameActive = false; // Tạm dừng chuyển động game
            
            currentQuestion = randomQuizList[currentQuizIndex];
            
            // Hiển thị nội dung
            document.getElementById('current-quiz-index').innerText = `${currentQuizIndex + 1}/20`;
            document.getElementById('quiz-question-text').innerHTML = `${currentQuestion.question}`;
            
            const optionsContainer = document.getElementById('quiz-options-container');
            optionsContainer.innerHTML = "";

            const alphabet = ["A", "B", "C", "D"];
            
            // Trình bày 4 đáp án dạng nút bấm tuyệt đẹp
            currentQuestion.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full bg-emerald-900/80 hover:bg-emerald-800 border border-emerald-500/20 text-left p-3 rounded-xl text-xs sm:text-sm font-medium transition-all flex items-center gap-3 text-emerald-100 hover:scale-[1.01]";
                btn.innerHTML = `<span class="bg-emerald-800 text-emerald-300 font-extrabold rounded-md px-1.5 py-0.5 text-[10px] uppercase">${alphabet[idx]}</span> <span class="flex-1">${opt}</span>`;
                btn.onclick = () => selectAnswer(idx, btn);
                optionsContainer.appendChild(btn);
            });

            // Ẩn hộp thoại giải thích và nút Tiếp tục
            document.getElementById('quiz-explanation-box').classList.add('hidden');
            document.getElementById('btn-quiz-next').classList.add('hidden');
            
            // Hiển thị màn hình Quiz
            document.getElementById('screen-quiz').classList.remove('hidden');
        }

        // Xử lý chọn đáp án trắc nghiệm
        function selectAnswer(selectedIndex, selectedBtn) {
            const optionsContainer = document.getElementById('quiz-options-container');
            const buttons = optionsContainer.getElementsByTagName('button');
            const isCorrect = (selectedIndex === currentQuestion.answer);

            // Khóa tất cả các nút
            for (let btn of buttons) {
                btn.disabled = true;
                btn.className = "w-full bg-emerald-950/40 border border-emerald-500/10 text-emerald-300/40 p-3 rounded-xl text-xs sm:text-sm font-medium flex items-center gap-3 cursor-not-allowed";
            }

            const explanationBox = document.getElementById('quiz-explanation-box');
            const feedbackTitle = document.getElementById('quiz-feedback-title');
            const explanationText = document.getElementById('quiz-explanation-text');
            const nextBtn = document.getElementById('btn-quiz-next');

            explanationBox.classList.remove('hidden');
            nextBtn.classList.remove('hidden');

            if (isCorrect) {
                // TRẢ LỜI ĐÚNG (+50đ)
                score += 50;
                sci = Math.min(100, sci + 5);
                hasShield = true; // Kích hoạt khiên chủ động
                
                feedbackTitle.innerText = "🎉 CHÍNH XÁC! +50 ĐIỂM";
                feedbackTitle.className = "font-black text-xs text-green-400 uppercase tracking-wide";
                selectedBtn.className = "w-full bg-emerald-800/80 border-2 border-green-400 text-white p-3 rounded-xl text-xs sm:text-sm font-black flex items-center gap-3";
                playSound('correct');
            } else {
                // TRẢ LỜI SAI (Phạt trừ 1 mạng, trừ SCI)
                lives--;
                sci = Math.max(0, sci - 10);
                
                feedbackTitle.innerText = `❌ CHƯA CHÍNH XÁC!`;
                feedbackTitle.className = "font-black text-xs text-rose-400 uppercase tracking-wide";
                selectedBtn.className = "w-full bg-rose-950/80 border-2 border-rose-500 text-rose-200 p-3 rounded-xl text-xs sm:text-sm font-black flex items-center gap-3";
                
                // Tô viền xanh cho đáp án đúng để sinh viên học tập kiến thức
                const correctBtn = buttons[currentQuestion.answer];
                correctBtn.className = "w-full bg-emerald-900 border-2 border-emerald-400 text-emerald-200 p-3 rounded-xl text-xs sm:text-sm font-black flex items-center gap-3";
                playSound('wrong');
            }

            explanationText.innerText = currentQuestion.explain;
            updateDashboard();

            // Nếu trả lời xong mà hết mạng thì kết thúc game ngay
            if (lives <= 0) {
                nextBtn.innerText = "XEM KẾT QUẢ 💔";
                nextBtn.onclick = () => {
                    document.getElementById('screen-quiz').classList.add('hidden');
                    endGame(false);
                };
            } else {
                nextBtn.innerText = "TẬP TRUNG CHẠY TIẾP 🏃‍♂️";
                nextBtn.onclick = () => {
                    // Tiếp tục cuộc chơi
                    document.getElementById('screen-quiz').classList.add('hidden');
                    currentQuizIndex++;
                    
                    if (currentQuizIndex >= 20) {
                        endGame(true); // Thắng cuộc khi hoàn thành 20 câu hỏi
                    } else {
                        // Resume game
                        gameActive = true;
                        lastTime = performance.now();
                        lastQuizTime = playTime;
                        // Xóa sạch vật phẩm cũ rơi dở dang để sinh viên kịp chuẩn bị tâm lý
                        items = [];
                    }
                };
            }
        }

        // KẾT THÚC TRÒ CHƠI (END GAME)
        function endGame(isVictory) {
            gameActive = false;
            document.getElementById('screen-game').classList.add('hidden');

            const rect = canvas.getBoundingClientRect();

            if (isVictory) {
                // TRƯỜNG HỢP CHIẾN THẮNG (VICTORY SCREEN)
                document.getElementById('screen-victory').classList.remove('hidden');
                document.getElementById('victory-score').innerText = score;
                document.getElementById('victory-sci').innerText = `${sci}%`;
                document.getElementById('victory-name').innerText = `${playerInfo.name} - ${playerInfo.mssv} (${playerInfo.class})`;
                
                // Kích hoạt pháo hoa giấy chiến thắng liên tục
                triggerConfetti(rect);

                // Cấu hình hành động cho nút Đồng bộ
                const syncBtn = document.getElementById('btn-sync');
                syncBtn.disabled = false;
                syncBtn.innerText = "ĐỒNG BỘ ĐIỂM RÈN LUYỆN ⚡";
                syncBtn.className = "w-full bg-gradient-to-r from-yellow-400 to-amber-500 text-emerald-950 font-extrabold py-3.5 rounded-xl transition-all hover:scale-[1.01] active:scale-[0.99] shadow-md text-sm";
                
                syncBtn.onclick = () => syncPoints();
            } else {
                // TRƯỜNG HỢP THUA CUỘC (GAME OVER SCREEN)
                document.getElementById('screen-gameover').classList.remove('hidden');
                document.getElementById('gameover-score').innerText = score;
                document.getElementById('gameover-sci').innerText = `${sci}%`;
            }
        }

        // Chơi lại từ đầu
        function restartGame() {
            document.getElementById('screen-victory').classList.add('hidden');
            document.getElementById('screen-gameover').classList.add('hidden');
            document.getElementById('screen-welcome').classList.remove('hidden');
        }

        // ĐỒNG BỘ ĐIỂM VỀ GOOGLE SHEETS QUA APPS SCRIPT
        function syncPoints() {
            const syncBtn = document.getElementById('btn-sync');
            syncBtn.disabled = true;
            syncBtn.innerText = "Đang truyền dữ liệu...";

            fetch(playerInfo.scriptUrl, {
                method: 'POST',
                mode: 'no-cors', // Sử dụng chế độ no-cors để tránh bị chặn liên tên miền (CORS)
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    name: playerInfo.name,
                    mssv: playerInfo.mssv,
                    class: playerInfo.class,
                    score: score,
                    correct: `${currentQuizIndex}/20`,
                    prize: `Chỉ số Sống Xanh đạt ${sci}%`
                })
            })
            .then(() => {
                alert(`Đồng bộ thành công rực rỡ!\n\nThông tin của sinh viên ${playerInfo.name} đã được ghi nhận trên Google Sheets của Ban tổ chức Đoàn - Hội khoa Toán - Thống kê.`);
                syncBtn.innerText = "ĐỒNG BỘ THÀNH CÔNG ✔";
                syncBtn.className = "w-full bg-emerald-800 text-emerald-100 font-extrabold py-3.5 rounded-xl cursor-not-allowed text-sm shadow-inner";
            })
            .catch(error => {
                console.error('Lỗi kết nối API!', error);
                alert("Đường truyền có chút trục trặc. Bạn hãy chụp lại màn hình kết quả này để BTC ghi nhận thủ công nhé!");
                syncBtn.disabled = false;
                syncBtn.innerText = "THỬ ĐỒNG BỘ LẠI";
            });
        }

        // Trình kích hoạt pháo hoa giấy chúc mừng khi Thắng (Victory Confetti)
        function triggerConfetti(rect) {
            try {
                const duration = 5 * 1000;
                const animationEnd = Date.now() + duration;
                
                const interval = setInterval(function() {
                    const timeLeft = animationEnd - Date.now();
                    if (timeLeft <= 0) {
                        return clearInterval(interval);
                    }
                    
                    const particleCount = 6;
                    createParticles(Math.random() * rect.width, 0, shuffleArray(['#f59e0b', '#10b981', '#10b981', '#3b82f6', '#ec4899'])[0], 5);
                }, 250);
            } catch(e) {
                // Fallback nếu có lỗi vẽ confetti ngoài biên
                console.log(e);
            }
        }

    </script>
