        // VÒNG LẶP CHƠI GAME CHÍNH (GAME LOOP)
        function gameLoop(timestamp) {
            if (!gameActive) return;

            const dt = timestamp - lastTime;
            lastTime = timestamp;
            playTime += dt;

            const rect = canvas.getBoundingClientRect();

            // Cập nhật vị trí các hạt pháo hoa ăn mừng (nếu có)
            for (let i = particles.length - 1; i >= 0; i--) {
                particles[i].x += particles[i].vx;
                particles[i].y += particles[i].vy;
                particles[i].vy += 0.08; // trọng lực mờ
                particles[i].alpha -= 0.015;
                if (particles[i].alpha <= 0) {
                    particles.splice(i, 1);
                }
            }

            // Sinh thêm các vật phẩm rơi tự do
            updateItems(rect);

            // Vẽ toàn bộ thế giới game
            drawGame(rect);

            // Cơ chế tự động kích hoạt Quiz theo thời gian (mỗi 35 giây nếu hứng không kịp)
            if (playTime - lastQuizTime > 35000) {
                lastQuizTime = playTime;
                triggerQuiz();
            }

            requestAnimationFrame(gameLoop);
        }

