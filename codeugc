        canvas.addEventListener('touchstart', handleTouch, { passive: false });

        // Di chuyển bằng bàn phím PC
        function handleKeyDown(e) {
            if (!gameActive) return;
            const rect = canvas.getBoundingClientRect();
            if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
                player.x -= player.speed;
            } else if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
                player.x += player.speed;
            }
            // Ràng buộc biên trái phải
            if (player.x < 0) player.x = 0;
            if (player.x > rect.width - player.width) player.x = rect.width - player.width;
        }

        // Di chuyển bằng cảm ứng điện thoại (Vuốt/Chạm)
        function handleTouch(e) {
            if (!gameActive) return;
            e.preventDefault(); // Ngăn trình duyệt tự động cuộn màn hình
            const rect = canvas.getBoundingClientRect();
            const touch = e.touches[0];
            const touchX = touch.clientX - rect.left;
            
            // Đặt trực tiếp tâm giỏ nằm đúng điểm chạm ngón tay của người dùng
            player.x = touchX - player.width / 2;
            
            // Giới hạn biên di chuyển
            if (player.x < 0) player.x = 0;
            if (player.x > rect.width - player.width) player.x = rect.width - player.width;
        }

